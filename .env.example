# Chave de API do Google Gemini (obtenha em https://aistudio.google.com/)
GEMINI_API_KEY=sua_chave_aqui

# Opcional: Versão da API (padrão automático: tenta v1 e depois v1beta)
# GEMINI_API_VERSION=v1

# Opcional: Modelo (padrão automático: tenta gemini-1.5-flash no v1, depois gemini-1.5-flash-latest no v1beta)
# GEMINI_MODEL=gemini-1.5-flash
